<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="JGarm">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import JGarm urdf file -->
    <xacro:include filename="$(find arm_description)/urdf/JGarm.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="JGarm.ros2_control.xacro" />


    <xacro:JGarm_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
